@model Wastelands.Service.Domain.Models.Requests.AddOrUpdateCharacterSkillRequest

@{
    ViewData["Title"] = "Add Character Skill";
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddSkill">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Skill" class="control-label"></label>
                <select asp-for="Skill"
                        class="form-control"
                        asp-items="Html.GetEnumSelectList<Wastelands.Service.Domain.Enums.Skill>()">
                    <option>Select Skill ...</option>
                </select>
                <span asp-validation-for="Skill" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Value" class="control-label"></label>
                <input asp-for="Value" class="form-control" />
                <span asp-validation-for="Value" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<p>@ViewData["ErrorMessage"]</p>

<div class="container">
    @Html.ActionLink("Back to Character", "Details", new { id = Model.CharacterId })
</div>


