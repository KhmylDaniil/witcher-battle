@model Wastelands.Service.Domain.Models.Dto.CharacterDto

@{
    ViewData["Title"] = "Details";
}

<h1>Character Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Int)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Int)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Str)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Str)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Rea)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Rea)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Dex)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Dex)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Cra)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Cra)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Emp)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Emp)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Wil)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Wil)
        </dd>
    </dl>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Skill")
            </th>
            <th>
                @Html.DisplayName("Value")
            </th>
            <th>
                @Html.ActionLink("Add new skill", "AddSkill",
                                  new { CharacterId = Model.Id })
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Skills)
        {
            <tr>
                <td>
                    @Html.DisplayName(item.Key.ToString())
                </td>
                <td>
                    @Html.DisplayName(item.Value.ToString())
                </td>
                <td>
                    @Html.ActionLink("Update value", "EditSkill",
                             new { CharacterId = Model.Id, Skill = item.Key, Value = item.Value })
                </td>
                <td>
                    <form asp-action="DeleteSkill" asp-route-Id=@Model.Id asp-route-skill=@item.Key>
                        <div class="form-group">
                            <input type="submit" value="Delete" class="btn btn-primary" />
                        </div>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<p>@ViewData["ErrorMessage"]</p>

<div>
    @Html.ActionLink("Delete", "Delete", new { id = Model.Id, name = Model.Name }) |
    <a asp-action="Index">Back to Characters</a>
</div>
