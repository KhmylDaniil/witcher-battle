@model Wastelands.Service.Domain.Models.Requests.AddOrUpdateCharacterSkillRequest

@{
    ViewData["Title"] = "Edit Character Skill";
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditSkill">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <p>@Model.Skill</p>
            <input asp-for="Skill" value="@Model.Skill" hidden=true class="form-control" />
            <div class="form-group">
                <label asp-for="Value" class="control-label"></label>
                <input asp-for="Value" class="form-control" />
                <span asp-validation-for="Value" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<p>@ViewData["ErrorMessage"]</p>

<div class="container">
    @Html.ActionLink("Back to Character", "Details", new { id = Model.CharacterId })
</div>


