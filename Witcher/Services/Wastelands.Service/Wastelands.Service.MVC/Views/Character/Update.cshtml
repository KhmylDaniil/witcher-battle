@model Wastelands.Service.Domain.Models.Requests.UpdateCharacterRequest

@{
    ViewData["Title"] = "Update";
}

<h1>Update</h1>

<h4>Update Character</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Update">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Int" class="control-label"></label>
                <input asp-for="Int" class="form-control" />
                <span asp-validation-for="Int" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Str" class="control-label"></label>
                <input asp-for="Str" class="form-control" />
                <span asp-validation-for="Str" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Rea" class="control-label"></label>
                <input asp-for="Rea" class="form-control" />
                <span asp-validation-for="Rea" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Dex" class="control-label"></label>
                <input asp-for="Dex" class="form-control" />
                <span asp-validation-for="Dex" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cra" class="control-label"></label>
                <input asp-for="Cra" class="form-control" />
                <span asp-validation-for="Cra" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Emp" class="control-label"></label>
                <input asp-for="Emp" class="form-control" />
                <span asp-validation-for="Emp" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Wil" class="control-label"></label>
                <input asp-for="Wil" class="form-control" />
                <span asp-validation-for="Wil" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<p>@ViewData["ErrorMessage"]</p>

<div>
    <a asp-action="Index">Back to Characters</a>
</div>

